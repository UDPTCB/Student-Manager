#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "myapp.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,1,0
PRODUCTVERSION 0,1,3,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"                  // English (US) + Unicode
        BEGIN
            VALUE "FileDescription",  "Student Information Management System"
            VALUE "FileVersion",      "1.0.2.0"
            VALUE "InternalName",     "Manager-Alpha"
            VALUE "LegalCopyright",   "Copyright © 2026"
            VALUE "ProductName",      "Student Manager"
            VALUE "ProductVersion",   "0.1.3-Alpha"
            VALUE "OriginalFilename", "manager.exe"        
            VALUE "CompanyName",      "None"                 
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200     // 0x409 = English (United States), 1200 = Unicode
    END
END